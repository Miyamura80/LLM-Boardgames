# Application Environment Variables
# Copy this file to .env and fill in the values
# Variables must be prefixed with APP__ to be loaded by the configuration system.
# Use double underscores (__) for nested fields.

# Environment: dev, prod
# Maps to AppConfig.dev_env
APP__DEV_ENV=dev

# LLM API Keys
# Maps to AppConfig.openai_api_key, etc.
APP__OPENAI_API_KEY=
APP__ANTHROPIC_API_KEY=
APP__GROQ_API_KEY=
APP__PERPLEXITY_API_KEY=
APP__GEMINI_API_KEY=

# OpenRouter covers every non-first-party model family (Mistral, DeepSeek, xAI,
# GLM, MiniMax, …) via `openrouter/<org>/<model>` seat strings. Read as a PLAIN
# env var, not APP__-prefixed. First-party OpenAI/Anthropic/Gemini use the keys
# above.
OPENROUTER_API_KEY=

# Examples of nested configuration overrides:
# APP__MODEL_NAME=gpt-4
# APP__LOGGING__VERBOSE=true
# APP__LOGGING__LEVELS__DEBUG=true
# APP__LLM_CONFIG__CACHE_ENABLED=true
# APP__DEFAULT_LLM__DEFAULT_TEMPERATURE=0.7

# Postgres eval store (docker compose up -d). Maps to AppConfig.database_url;
# plain DATABASE_URL also works.
APP__DATABASE_URL=postgres://shbench:shbench@localhost:5433/shbench
